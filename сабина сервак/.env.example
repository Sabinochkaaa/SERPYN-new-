# Обязательные переменные
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres
INGEST_TOKEN=ваш_секретный_токен
DATA_ENCRYPTION_KEY=ваш_ключ_фернет_из_32_байт_base64

# Опциональные
LOG_LEVEL=INFO
DB_POOL_MAX_SIZE=10
RISK_THRESHOLD_HIGH=0.75
RISK_THRESHOLD_MEDIUM=0.50
CORS_ORIGINS=*
DB_SSL=require
PORT=8000
RELOAD=false
